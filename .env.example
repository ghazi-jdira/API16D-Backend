# Copy to .env (local) or set these in the Render dashboard (production).

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Set a stable value in production so restarts don't log everyone out.
SECRET_KEY=replace-with-a-long-random-hex-string

# Comma-separated browser origins allowed to call the API (CORS).
# Your GitHub Pages origin, e.g. https://<github-user>.github.io
ALLOWED_ORIGINS=https://your-user.github.io,http://localhost:8123

# Optional: how long a login stays valid, in seconds (default 43200 = 12h).
# TOKEN_TTL_SECONDS=43200
